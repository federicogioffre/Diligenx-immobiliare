DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diligenx
# Optional: DDL-capable connection for Alembic only. Set it when DATABASE_URL
# uses the non-superuser RLS role (diligenx_app); leave empty otherwise.
MIGRATIONS_DATABASE_URL=
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
# Secure attribute on auth cookies. Set to false ONLY for local development
# over plain http (Safari refuses Secure cookies on http://localhost).
AUTH_COOKIE_SECURE=true
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Cloud storage — leave S3_BUCKET empty to use local disk (development)
# For Cloudflare R2:
#   S3_ENDPOINT_URL = https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION       = auto
# For AWS S3:
#   S3_ENDPOINT_URL = (leave empty)
#   S3_REGION       = eu-west-1  (or your region)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Optional, only when explicitly selecting a claude-* analysis model.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=gpt-5.6-luna
# Model for the judgment stages (red-flag aggregation, source-fidelity review,
# executive summary). Empty = same as ANALYSIS_MODEL. Production: claude-sonnet-5.
JUDGMENT_MODEL=
# Max parallel per-document LLM calls within an analysis stage.
# Set to 1 to force fully sequential processing.
LLM_MAX_CONCURRENCY=4

# Error monitoring (Sentry) — leave empty to disable.
# Create a project at sentry.io, copy the DSN, set it here (or in the
# Railway Variables tab for production).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Outbound email (SMTP) — leave SMTP_HOST empty to disable sending;
# the password-reset flow then logs the reset link instead of emailing it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=https://www.diligenx.it


# External beta guard; requires PG/RLS, Redis, S3, actual provider keys and HTTPS.
BETA_MODE=false
WORKER_MAX_JOBS=4
WORKER_JOB_TIMEOUT_SECONDS=10800
WORKER_MAX_TRIES=3
LLM_MAX_IN_FLIGHT=4
UPLOAD_RATE_LIMIT=120/minute
UPLOAD_BATCH_RATE_LIMIT=10/minute
